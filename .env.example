# All runtime files are project-local. No online API key is required.
KB_DATA_DIR=runtime
KB_MODELS_CACHE_DIR=runtime/models
# Set the executable to your installed or portable Ollama program.
# Its model storage stays in this project via KB_OLLAMA_MODELS_DIR.
KB_OLLAMA_EXECUTABLE=
KB_OLLAMA_MODELS_DIR=runtime/local_ollama_models
KB_OLLAMA_BASE_URL=http://127.0.0.1:11435
KB_CHAT_MODEL=qwen2.5:7b
KB_TOKENIZER_MODEL=Qwen/Qwen2.5-7B-Instruct
KB_KNOWLEDGE_BASE_SCOPE=AtlasDesk（星河工单）研发技术文档，包含v1和v2版本
# Optional helper: model and its real tokenizer must both be available.
# Set both model fields empty to use the main model for all structured calls.
KB_STRUCTURED_MODEL=qwen2.5:3b
KB_STRUCTURED_TOKENIZER_MODEL=Qwen/Qwen2.5-3B-Instruct
# Exact schema names, CSV. Empty means ALL structured schemas use the helper.
KB_STRUCTURED_MODEL_SCHEMAS=ConversationSummary,EvidenceDigest
KB_EMBEDDING_MODEL=BAAI/bge-m3
KB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KB_DEVICE=cpu
KB_LOW_MEMORY_MODE=true
# Leave empty to use embedded Qdrant. A Docker server is optional.
KB_QDRANT_URL=
KB_CONTEXT_WINDOW_TOKENS=8192
KB_OUTPUT_RESERVE_TOKENS=768
KB_EVIDENCE_TOKEN_BUDGET=2400
# This CPU profile executes heavy model work serially; Send remains available.
KB_MAX_PARALLEL_TASKS=1
KB_MAX_TASKS=4
# complex skips completeness review on simple questions and reports it as skipped.
# always runs the explicit review for every agent question with evidence.
KB_EVIDENCE_REVIEW_POLICY=complex
KB_REQUEST_TIMEOUT_SECONDS=600
KB_TASK_TIMEOUT_SECONDS=1800
KB_RUN_TIMEOUT_SECONDS=5400
KB_RERANK_TOP_K=4
KB_HOST=127.0.0.1
KB_PORT=7860

